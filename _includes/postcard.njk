{#- Expects `post` (collection item) and optional `featured`, `number` -#}
<li class="card{% if featured %} card-featured{% endif %}">
	<div class="card-meta">
		{%- if number %}<span class="card-number">{{ number }}</span> &middot; {% endif -%}
		<time datetime="{{ post.date | htmlDateString }}">{{ post.date | readableDate("LLLL d, yyyy") }}</time>
		&middot; {{ post.templateContent | readingTime }} min read
	</div>
	<h3 class="card-title"><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
	{%- if post.data.description %}<p class="card-desc">{{ post.data.description | trim }}</p>{% endif %}
	{%- set cardTags = post.data.tags | filterTagList %}
	{%- if cardTags.length %}
	<div class="card-tags">
		{%- for tag in cardTags | head(3) %}
		<a class="tag-pill" href="/tags/{{ tag | slugify }}/">{{ tag }}</a>
		{%- endfor %}
	</div>
	{%- endif %}
</li>
